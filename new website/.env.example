# Site URL used for metadata, sitemap, and OG links.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact/Support form delivery (Resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@example.com
CONTACT_TO_EMAIL=hello@example.com
SUPPORT_TO_EMAIL=support@example.com

# Or use SMTP via Nodemailer (uncomment and fill if not using Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=xxxxxxxx
